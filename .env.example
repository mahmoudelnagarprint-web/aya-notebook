# ---------------------------------------------------------------------------
# Local-first default: leave SUPABASE_URL unset and Aya persists to SQLite at
# apps/server/data/ayatodoist.db (or $AYATODOIST_DB).
#
# To run against Supabase, set the three values below, apply supabase/schema.sql
# in the Supabase SQL Editor, and the server switches every CRUD path (tasks,
# projects, sections, labels, settings, Aya providers/conversations, uploads)
# to Supabase Postgres.
#
# Production (Netlify Functions, NETLIFY=true) REQUIRES Supabase: the function
# refuses to boot without these values instead of falling back to memory.
# ---------------------------------------------------------------------------
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_DB_PASSWORD=

# Optional. When set, /api/* requires either `Authorization: Bearer <API_KEY>`
# or `x-api-key: <API_KEY>`. Same-origin browser requests from the web UI and
# GET /api/v1/health + /api/v1/openapi.json stay open.
# API_KEY=

# Optional overrides
# PORT=8787
# AYATODOIST_DB=./data/ayatodoist.db
